SECRET_KEY=change-me-to-a-long-random-value

# Only set this to "true" once you're sure every request reaches this app over HTTPS
# (e.g. behind a reverse proxy or tunnel that terminates TLS). Left off by default so
# LAN-only / plain-http setups don't get silently locked out of login.
# SESSION_COOKIE_SECURE=true

# Off-site backups -- see DEPLOY.md "Backups" section for setup
BACKUP_S3_BUCKET=your-bucket-name
BACKUP_S3_ACCESS_KEY_ID=your-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY=your-secret-access-key
# BACKUP_S3_ENDPOINT=s3.amazonaws.com  # for AWS, most regions need s3.<region>.amazonaws.com instead (e.g. s3.eu-west-1.amazonaws.com), or non-AWS providers use their own endpoint
# BACKUP_NOTIFICATION_URL=ntfy://ntfy.sh/your-topic-name?title=Wilik  # optional, push notification if a backup fails
# BACKUP_CRON_EXPRESSION=0 3 * * *  # optional, when backups run (default: daily at 03:00)
# BACKUP_RETENTION_DAYS=30  # optional, how long backups are kept (default: 30 days)
# TZ=Europe/Brussels  # optional, time zone for the schedule above (default: UTC)

# Optional: publish Wilik on another port, or only on localhost (e.g. 127.0.0.1:8090)
# when a reverse proxy reaches it over a Docker network. Default: 8090.
# WILIK_PORT=8090
